# API base used by the UI.
# Leave empty to use same-origin in production. In development, the UI defaults to http://localhost:9060
# To override in development set:
# VITE_API_BASE=http://localhost:9060
VITE_API_BASE=

# Optional Google Analytics measurement ID (GA4)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=
